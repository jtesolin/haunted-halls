# Copy this file to terraform.tfvars and replace the placeholders before running Terraform.
# This file is intentionally committed; real values remain local and uncommitted.

project_id = "your-gcp-project-id"
region = "us-east1"
billing_account_id = "000000-000000-000000"
budget_amount = "20"
github_owner = "jtesolin"
frontend_repo_name = "haunted-halls"
engine_repo_name = "haunted-halls-engine"

# D4B: Cloud SQL and Secret Manager configuration
# Increment version numbers to rotate generated credentials
cloud_sql_tier           = "db-f1-micro"
cloud_sql_disk_size      = 10
database_password_version = 1
staging_database_password_version = 1
internal_service_token_version = 1
staging_internal_service_token_version = 1
nextauth_secret_version = 1
staging_nextauth_secret_version = 1

# D4C: migration-only first phase. The engine image is required because the
# migration job uses the same immutable image as the eventual engine service.
application_services_enabled = false
engine_image = "replace-with-reviewed-immutable-engine-image"

# D6A: Optional production custom frontend domain. Leave empty until ownership
# of the base domain is verified and the Cloud Run mapping is ready to be created.
frontend_custom_domain = ""

# After haunted-halls-migrate executes successfully, set the gate to true and
# provide the frontend image and production OAuth configuration.
frontend_image = ""
google_oauth_client_id = ""
openai_api_key_version = 2
google_client_secret_version = 0

# Staging environment. Apply these resources before merging workflow changes
# that redirect automatic frontend deployment to staging.
staging_application_services_enabled = false
staging_frontend_custom_domain = "staging.haunted-halls.tesolin.us"
staging_frontend_image = "replace-with-reviewed-immutable-frontend-image"
staging_engine_image = "replace-with-reviewed-immutable-engine-image"

# Operator action required before enabling staging services:
# create/configure a Google OAuth Web Application client for staging with:
#   Authorized JavaScript origin: https://staging.haunted-halls.tesolin.us
#   Authorized redirect URI: https://staging.haunted-halls.tesolin.us/api/auth/callback/google
# then add the client secret as a new version of hh-google-client-secret-staging.
staging_google_oauth_client_id = ""
staging_google_client_secret_version = 0
