# Haunted Halls BFF settings
INTERNAL_ENGINE_SERVICE_TOKEN=generate-with-openssl-do-not-commit
ENGINE_BASE_URL=http://localhost:8000
# Optional: set only when the engine is a private Cloud Run service.
ENGINE_ID_TOKEN_AUDIENCE=
MAX_INPUT_CHARACTERS=2000

# Auth.js / NextAuth settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Local Docker Compose PostgreSQL configuration
POSTGRES_PASSWORD=replace-with-local-postgres-password

# Test-only NextAuth authentication seam for local/CI Playwright E2E runs.
# SERVER-SIDE ONLY. Must remain unset (or false) outside a loopback E2E stack.
# See README "End-to-end (Playwright) testing" for the full safety contract.
E2E_AUTH_ENABLED=false

